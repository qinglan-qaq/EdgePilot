# EdgePilot 本地栈环境变量示例（docker/compose/docker-compose.yml 配套）
# 复制为 docker/compose/.env 后按需修改；不要提交真实密钥。
# 注意：backend 测试默认仍使用 OBS_ENABLED=false（见 backend/.env.example）；
# 这里的 OBS_ENABLED=true 只作用于 compose 中的 api/worker 容器运行环境。

# --- PostgreSQL ---
POSTGRES_USER=edgepilot
POSTGRES_PASSWORD=edgepilot
POSTGRES_DB=edgepilot

# --- Redis / RabbitMQ / MQTT ---
REDIS_URL=redis://localhost:6379/0
RABBITMQ_DEFAULT_USER=edgepilot
RABBITMQ_DEFAULT_PASS=edgepilot
MQTT_HOST=localhost
MQTT_PORT=1883

# --- 认证（部署时务必覆盖） ---
JWT_SECRET=change-me-in-prod

# --- 观测 ---
OBS_ENABLED=true
OBS_CAPTURE_MODE=REDACTED

# --- LLM（本地/CI 默认 mock，不访问外网） ---
LLM_MODE=mock
