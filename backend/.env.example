# EdgePilot backend 环境变量示例。复制为 backend/.env 后按需修改。
# 不要在此文件写入真实密钥；JWT_SECRET 必须通过部署环境覆盖。

APP_NAME=edgepilot
ENV=dev

# 数据库 / 中间件
DATABASE_URL=postgresql+asyncpg://edgepilot:edgepilot@localhost:5433/edgepilot
TEST_DATABASE_URL=postgresql+asyncpg://edgepilot:edgepilot@localhost:5433/edgepilot_test
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://edgepilot:edgepilot@localhost:5672//
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 认证
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001

# 观测
OBS_ENABLED=false
OBS_CAPTURE_MODE=REDACTED
OBS_QUEUE_SIZE=10000
OBS_BATCH_SIZE=200
OBS_FLUSH_MS=500
OBS_SAMPLE_RATE=1.0
OBS_LIVE_TTL_SECONDS=3600

# LLM / 存储 / 指标
LLM_MODE=auto
LLM_FIXTURE_DIR=tests/fixtures/llm
DEEPSEEK_API_KEY=
STORAGE_DIR=./var
SNAPSHOT_TTL_DAYS=90
METRICS_ENABLED=true

# Vision Center（YOLO 视觉识别）
# 推理服务不可用不影响其它模块：vision 路由返回 503、轮询器不启动，其它 API 照常工作。
VISION_ENABLED=true
VISION_SERVICE_URL=http://127.0.0.1:8001
VISION_SERVICE_TOKEN=
VISION_SERVICE_TIMEOUT_S=5
VISION_POLL_INTERVAL_S=2
VISION_POLL_MAX_FAILURES=30
VISION_POLL_BACKOFF_MAX_S=30
VISION_TASK_TIMEOUT_S=1800
# 相对路径按 backend cwd 解析；留空时使用 STORAGE_DIR/vision
VISION_STORAGE_DIR=
VISION_MAX_UPLOAD_MB=200
VISION_MAX_VIDEO_SECONDS=900
VISION_TARGET_FRAMES=900
VISION_MAX_SAMPLES=2000
VISION_MAX_FRAME_STRIDE=300
VISION_DEFAULT_CONF=0.25
VISION_EVENT_CONF=0.6
VISION_EVENT_COOLDOWN_S=5
VISION_TRIGGER_ENABLED=true
VISION_TRIGGER_WORKFLOW_NAME=视觉事件研判（演示）
VISION_TRIGGER_ONCE_PER_TASK=true
VISION_AGENT_ENABLED=true
VISION_AGENT_ONCE_PER_TASK=true
VISION_MODEL_KEY=yolo11n
VISION_MAX_RETRIES=3
VISION_RESULT_RETENTION_DAYS=90
VISION_MEDIA_TTL_S=3600
