# EdgePilot backend 环境变量示例。复制为 backend/.env 后按需修改。
# 不要在此文件写入真实密钥；JWT_SECRET 必须通过部署环境覆盖。

APP_NAME=edgepilot
ENV=dev

# 数据库 / 中间件
DATABASE_URL=postgresql+asyncpg://edgepilot:edgepilot@localhost:5432/edgepilot
TEST_DATABASE_URL=postgresql+asyncpg://edgepilot:edgepilot@localhost:5432/edgepilot_test
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://edgepilot:edgepilot@localhost:5672//
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 认证
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001

# 观测
OBS_ENABLED=false
OBS_CAPTURE_MODE=REDACTED
OBS_QUEUE_SIZE=10000
OBS_BATCH_SIZE=200
OBS_FLUSH_MS=500
OBS_SAMPLE_RATE=1.0
OBS_LIVE_TTL_SECONDS=3600

# LLM / 存储 / 指标
LLM_MODE=auto
LLM_FIXTURE_DIR=tests/fixtures/llm
DEEPSEEK_API_KEY=
STORAGE_DIR=./var
SNAPSHOT_TTL_DAYS=90
METRICS_ENABLED=true
